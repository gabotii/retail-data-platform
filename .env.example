# Copy to .env for local development (never commit .env).
APP_ENV=development
DATABASE_URL=postgresql+psycopg://retail:change-me@127.0.0.1:5432/retail
TEST_DATABASE_URL=postgresql+psycopg://retail:change-me@127.0.0.1:5432/retail_test
DATA_DIR=data
DEMO_API_URL=http://127.0.0.1:8001
DEMO_API_TOKEN=demo-token
DEMO_API_FAILURE_RATE=0.1
LOG_FORMAT=console
LOG_LEVEL=INFO
# Optional: protects POST /pipeline/runs on the KPI API
API_KEY=
# Synthetic world (shared by the CSV generator and the demo inventory API)
SIM_SEED=42
SIM_START_DATE=2026-07-01
SIM_DAYS=60
SIM_TRAFFIC_SCALE=0.5
SIM_DIRTY_RATE=0.01
